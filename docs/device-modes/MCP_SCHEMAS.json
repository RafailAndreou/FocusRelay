  {
    "name": "create_mode_sequence",
    "description": "Save at most 16 sequential snapshotted mode activations starting at an absolute offset-qualified time. Steps are contiguous, persisted on the phone, and total at most seven days. No workflow engine or natural-language parsing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "modeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "durationMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10080
              }
            },
            "required": [
              "modeId",
              "durationMinutes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "startAt",
        "steps"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
